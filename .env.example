# 复制为 .env.local 后填写真实值
#
# 后台登录密码（/admin）
ADMIN_PASSWORD=change-me

# 会话 cookie 签名密钥，任意随机长字符串
# 可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# 站点域名，用于生成 sitemap / OG 元信息
NEXT_PUBLIC_SITE_URL=http://localhost:3000
